{
  "manifest_version": 2,
  "name": "BYD Session Bridge",
  "version": "1.0.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "session-bridge@byd.theolm.dev"
    }
  },
  "permissions": ["cookies", "geckoViewAddons", "nativeMessaging", "<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  }
}
